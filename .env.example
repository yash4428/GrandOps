# Copy to .env.local for local dev. All values here are non-secret defaults.
DATA_BACKEND=memory            # memory | firestore
GOOGLE_CLOUD_PROJECT=demo-autopilot
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
APP_ENV=local                  # local | review | staging | production
# Mission Control reads GitLab with a read-only token (Secret Manager in Cloud Run)
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_PROJECT_ID=
# GITLAB_READ_TOKEN=           # never commit
# ERROR_TRACKING_DSN=          # GitLab Error Tracking (Sentry-compatible) DSN
# REPORTS_ISSUE_TOKEN=         # token used by the backend to file user-report issues
