    "seed": "tsx scripts/seed.ts",
    "sci": "tsx scripts/sci/index.ts",
    "gate": "tsx scripts/merge-gate/index.ts",
    "carbon-gate": "tsx scripts/carbon-gate/index.ts",
    "trust": "tsx scripts/trust/index.ts",
    "diary": "tsx scripts/diary/index.ts",
    "audit": "tsx scripts/audit/index.ts",
    "chaos-guard": "tsx scripts/chaos-guard/index.ts",
    "pii-scan": "tsx scripts/pii-scan/index.ts",
    "i18n-check": "tsx scripts/i18n-check/index.ts",
    "persona-comment": "tsx scripts/persona-report/index.ts",
    "canary-watch": "tsx scripts/canary/watch.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "9.4.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
